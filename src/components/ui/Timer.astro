---
export interface Props {
    date?: number,
    startDate?: number,
    endDate?: number,
}

const {date, startDate, endDate} = Astro.props;
const targetStartDate = startDate ?? date ?? 0;
const targetEndDate = endDate ?? 0;
---

<div>
    <div class = "started">
        <slot name = "before"/>
    </div>
    <div class = "countdown inline-flex justify-center text-center gap-x-4 sm:gap-x-8 prose-p:mt-0 prose-p:mb-0 font-brand">
        <div class = "my-auto">
            <p class = "text-2xl lg:text-5xl days text-primary">0</p>
            <p class = "font-bold">Days</p>
        </div>

        <div class = "my-auto">
            <p class = "text-2xl lg:text-5xl hours text-primary">0</p>
            <p class = "font-bold">Hours</p>
        </div>

        <div class = "my-auto">
            <p class = "text-2xl lg:text-5xl minutes text-primary">0</p>
            <p class = "font-bold">Minutes</p>
        </div>

        <div class = "my-auto">
            <p class = "text-2xl lg:text-5xl seconds text-primary">0</p>
            <p class = "font-bold">Seconds</p>
        </div>
    </div>

    <div class = "hidden completed">
        <slot name = "after"/>
    </div>

    <div class = "hidden ended">
        <slot name = "ended"/>
    </div>
</div>

<script is:inline define:vars = {{targetStartDate, targetEndDate}}>

    let timerInterval = null;

    const updateCountdown = () => {

        const now = new Date().getTime();

        // Check if the event has ended.
        if (targetEndDate && now >= targetEndDate) {

            if (timerInterval) clearInterval(timerInterval);

            const started = document.querySelector(".started");
            const countdown = document.querySelector(".countdown");
            const completed = document.querySelector(".completed");
            const ended = document.querySelector(".ended");

            if (started) started.style.display = 'none';
            if (countdown) countdown.style.display = 'none';
            if (completed) completed.style.display = 'none';
            if (ended) ended.style.display = 'block';
            return;
        }

        const total = targetStartDate - now;

        // Start time reached / event is currently active.
        if (total <= 0) {

            if (!targetEndDate && timerInterval) {
                clearInterval(timerInterval);
            }

            const started = document.querySelector(".started");
            const countdown = document.querySelector(".countdown");
            const completed = document.querySelector(".completed");
            const ended = document.querySelector(".ended");

            if (started) started.style.display = 'none';
            if (countdown) countdown.style.display = 'none';
            if (completed) completed.style.display = 'block';
            if (ended) ended.style.display = 'none';
            return;
        }

        const seconds = Math.floor((total / 1000) % 60);
        const minutes = Math.floor((total / 1000 / 60) % 60);
        const hours = Math.floor((total / (1000 * 60 * 60)) % 24);
        const days = Math.floor(total / (1000 * 60 * 60 * 24));

        const daysEl = document.querySelector(".days");
        const hoursEl = document.querySelector(".hours");
        const minutesEl = document.querySelector(".minutes");
        const secondsEl = document.querySelector(".seconds");

        if (daysEl) daysEl.innerText = days.toString().padStart(2, "0");
        if (hoursEl) hoursEl.innerText = hours.toString().padStart(2, "0");
        if (minutesEl) minutesEl.innerText = minutes.toString().padStart(2, "0");
        if (secondsEl) secondsEl.innerText = seconds.toString().padStart(2, "0");
    };

    // Invoke immediately.
    updateCountdown();
    timerInterval = setInterval(updateCountdown, 1000);
</script>

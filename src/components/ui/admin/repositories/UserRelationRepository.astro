---
import type {BaseRepository} from "../../../../lib/types";
import {actions} from "astro:actions";
interface Props {
    repository: BaseRepository
}
const {repository} = Astro.props;
---


<div class:list = {["p-4 w-full border relative bg-white/5 border-white/10", {"bg-red-900 bg-opacity-25": repository.invalid}]}>
    <div class = "flex gap-x-2">
        <img src = {repository.ownerAvatarUrl} alt = {repository.owner} class = "w-16 h-16 rounded-full"/>
        <div class = "flex flex-col gap-y-1 flex-grow">
            <a href = {repository.ownerHtmlUrl} target = "_blank" rel = "noreferrer">{repository.owner}</a>

            <a href = {repository.url} target = "_blank" rel = "noreferrer">{repository.name}</a>

            {repository.description &&
                    <div class = "p-2 font-mono break-all bg-white bg-opacity-5">
                        {repository.description}
                    </div>
            }

            <div class = "flex flex-col sm:flex-row gap-2">

                <form method = "POST" action = {actions.repository.clear_submitter} class = "w-full">
                    <input type = "hidden" value = {repository.repository_id} name = "id"/>
                    <button type = "submit" class = " bg-orange-700 hover:bg-orange-600 border-t border-white/10 w-full h-full flex gap-x-1 justify-center place-items-center py-1 basic-link">
                        <span>Clear Submitter info</span>
                    </button>
                </form>

                <form method = "POST" action = {actions.repository.delete} class = "w-full">
                    <input type = "hidden" value = {repository.repository_id} name = "id"/>
                    <button type = "submit" class = " bg-red-700 hover:bg-red-600 border-t border-white/10 w-full h-full flex gap-x-1 justify-center place-items-center py-1 basic-link">
                        <span>Delete Repository</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
